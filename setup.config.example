# setup.config - site settings read by install.sh, upgrade_services.sh, monitor_services.sh,
# update_turn_ip.sh and backup_matrix.sh.
# Copy to setup.config (git-ignored, keep it mode 600) and edit.

# --- Names -------------------------------------------------------------------
# Public hostname of the homeserver; also the Matrix server_name (@user:chat.example.com)
MATRIX_FQDN="chat.example.com"
# Matrix Authentication Service hostname (default: auth.$MATRIX_FQDN)
# AUTH_FQDN="auth.chat.example.com"

# --- Network -----------------------------------------------------------------
# This host's LAN IP (auto-detected if empty). coturn/LiveKit relay on it.
LAN_IP="192.168.1.100"
# The edge reverse proxy (e.g. Caddy on the firewall) that forwards HTTPS here.
# nginx trusts X-Forwarded-For only from this address.
EDGE_PROXY_IP="192.168.1.1"
# A hostname that always resolves to your public IP (DDNS). coturn advertises it;
# update_turn_ip.sh checks the real public IP every 30 s (direct OpenDNS query)
# and falls back to this name if that fails.
TURN_DDNS_HOST="home.example.com"
# PUBLIC_IP="203.0.113.10"   # optional override if TURN_DDNS_HOST cannot be resolved

# --- Federation ---------------------------------------------------------------
# false = private server: no contact with any other Matrix server (docs/PRIVATE_SERVER.md).
FEDERATION_ENABLED="true"

# --- Initial admin (created in MAS) -----------------------------------------
ADMIN_USER="admin"
# ADMIN_PASS=""              # generated and saved to /root/matrix_credentials.txt if empty

# --- Email (optional; enables MAS password recovery + Synapse notifications) --
SMTP_HOST=""                 # e.g. smtp.mailgun.org
SMTP_PORT="587"              # STARTTLS
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""                 # e.g. matrix@mg.example.com
SMTP_REPLY_TO=""             # defaults to SMTP_FROM

# --- Element Web -------------------------------------------------------------
ELEMENT_COUNTRY_CODE="US"    # default for phone-number entry
# MAPTILER_KEY=""            # enables location-sharing maps

# --- Backups (backup_matrix.sh / matrix-backup.timer) ------------------------
# Make /mnt/backup a mount point on separate storage (e.g. Proxmox mp0).
BACKUP_DIR="/mnt/backup/matrix"

# BACKUP_KEEP_DAYS=14         # delete completed backups older than this...
# BACKUP_KEEP_MIN=3           # ...but always keep the newest N
# BACKUP_REQUIRE_MOUNT=1      # refuse to back up unless /mnt/backup is a mount point

# --- Monitoring (monitor_services.sh) ----------------------------------------
# Discord-compatible webhook for alerts (leave empty to only log)
MONITOR_WEBHOOK_URL=""
# MONITOR_REALERT_HOURS=6     # repeat an unchanged alert this often
# MONITOR_CERT_WARN_DAYS=14    # alert when the TLS cert expires sooner
# MONITOR_DISK_WARN_PCT=90     # alert when / or BACKUP_DIR is this full

# --- Environment variables (not read from this file) ------------------------
# GITHUB_TOKEN=...      raises the GitHub API rate limit for install/upgrade
# ALLOW_UNVERIFIED=1    install a release asset even without a published SHA-256 digest
