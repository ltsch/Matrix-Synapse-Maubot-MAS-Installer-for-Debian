# This repository lives in /root, so ignore everything and allow-list project files.
/*
!/.gitignore
!/README.md
!/docs/
!/lib/
!/mas-invite/
!/install.sh
!/upgrade_services.sh
!/backup_matrix.sh
!/monitor_services.sh
!/refresh_certs.sh
!/update_turn_ip.sh
!/manage_users.py
!/maubot_requirements.txt
!/setup.config.example
!/refresh_certs.conf.example

# Never commit site config or secrets, even inside allow-listed paths
setup.config
refresh_certs.conf
*.pem
*.key
__pycache__/
